# Kopier denne til .env.local og fyll inn.
# Hent nøkkel på https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Valgfritt – overstyr modell uten å endre kode.
# claude-sonnet-5 (standard) | claude-opus-5 (for vanskelige rapporter)
ANTHROPIC_MODEL=claude-sonnet-5

# ===== Pilot / produksjon =====
# Kommaseparerte invitasjonskoder – én per kunde. Tom = åpen (lokal utvikling).
ACCESS_CODES=
RATE_PER_MIN=6
QUOTA_PER_DAY=40
# Valutakurs for kostnadslogging
USD_NOK=10.5

# ===== Testlab: OpenRouter (eksperiment-branch) =====
# anthropic (standard) | openrouter
ENGINE=anthropic
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
